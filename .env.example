PORT=8787
ROLEMEM_DB=data/rolemem.db

# One admin token for the whole server. Required in production, at least 16 characters.
# If you leave it empty outside production, the server writes data/admin.token and prints it once.
ROLEMEM_ADMIN_TOKEN=

# Public origin used in connection-key snippets. No trailing slash.
# ROLEMEM_PUBLIC_URL=https://memory.example.com

# Set to 1 behind Caddy or Cloudflare so rate limits use the client IP.
# ROLEMEM_TRUST_PROXY=1

# Optional. Requests per minute per IP bucket. Default 240 for HTTP, 120 for MCP.
# ROLEMEM_RATE_PER_MIN=240

# Digest caps. Full inject while under both. Defaults: 300 memories, 48000 characters.
# ROLEMEM_DIGEST_MAX=300
# ROLEMEM_DIGEST_CHAR_CAP=48000

# Only for `npm run eval`. The server itself never calls a model.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
